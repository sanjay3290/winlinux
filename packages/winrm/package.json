{
  "name": "@winlinux/winrm",
  "version": "1.0.0",
  "description": "WinRM (WS-Management) client for Node.js: run commands and PowerShell, read event logs, list services and processes on Windows servers.",
  "keywords": [
    "winrm",
    "ws-management",
    "powershell",
    "windows",
    "remote",
    "ntlm",
    "kerberos"
  ],
  "homepage": "https://github.com/sanjay3290/winlinux/tree/main/packages/winrm#readme",
  "bugs": {
    "url": "https://github.com/sanjay3290/winlinux/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanjay3290/winlinux.git",
    "directory": "packages/winrm"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/src/winrm/index.js",
  "types": "dist/src/winrm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/winrm/index.d.ts",
      "default": "./dist/src/winrm/index.js"
    }
  },
  "files": [
    "dist/src",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && tsc && cp -r test/fixtures dist/test/fixtures",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "test:live": "npm run build && node dist/test/live/run-live.js",
    "test:kdc": "npm run build && node --test \"dist/test/kdc/*.live.js\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@winlinux/auth": "^1.0.0",
    "@types/node": "^22",
    "typescript": "^5.6"
  },
  "publishConfig": {
    "access": "public"
  }
}
